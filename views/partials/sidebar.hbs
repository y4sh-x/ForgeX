<aside id="sidebar" class="fixed inset-y-0 left-0 z-40 h-dvh w-64 -translate-x-full border-r border-line bg-surface transition-transform lg:sticky lg:top-0 lg:translate-x-0">
  <div class="flex h-full flex-col">
    <a href="/" class="flex items-center gap-3 border-b border-line px-4 py-4 texture-top">
      {{> brand-lockup size='size-9' textSize='text-[11px]'}}
    </a>

    <nav class="flex-1 space-y-1 overflow-y-auto p-3">
      <div class="px-3 pb-1 pt-1 eyebrow">General</div>
      <a class="nav-item {{#if (eq active 'dashboard')}}active{{/if}}" href="/">
        {{{icon 'house' 'size-4'}}} Dashboard
      </a>
      <a class="nav-item {{#if (eq active 'servers')}}active{{/if}}" href="/servers">
        {{{icon 'server' 'size-4'}}} Servers
      </a>

      {{#if servers.length}}
        <div class="px-3 pb-1 pt-4 eyebrow">Your Servers</div>
        <div class="space-y-0.5">
          {{#each servers}}
            <a class="nav-item" href="/servers/{{id}}">
              <img src="{{iconSrc this.icon}}" alt="" class="size-5 rounded-sm" style="background: {{this.accent}}" data-fallback-icon="/icons/servers/grass.svg">
              <span class="truncate" title="{{name}}">{{name}}</span>
              <span class="status-dot relative ml-auto shrink-0 {{statusDot status}} {{#if (statusPulse status)}}pulse{{/if}}" title="{{statusLabel status}}"></span>
            </a>
          {{/each}}
        </div>
      {{/if}}
    </nav>

    <div class="space-y-0.5 border-t border-line p-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))]">
      {{#if (eq user.role 'admin')}}
        <div class="px-3 pb-1 eyebrow">Administration</div>
        <a href="/nodes" class="nav-item {{#if (eq active 'nodes')}}active{{/if}}">
          {{{icon 'server-cog' 'size-4'}}} Nodes
        </a>
        <a href="/allocations" class="nav-item {{#if (eq active 'allocations')}}active{{/if}}">
          {{{icon 'network' 'size-4'}}} Allocations
        </a>
        <a href="/databases" class="nav-item {{#if (eq active 'databases')}}active{{/if}}">
          {{{icon 'database' 'size-4'}}} Databases
        </a>
        <a href="/settings/permissions" class="nav-item {{#if (eq active 'permissions')}}active{{/if}}">
          {{{icon 'shield-check' 'size-4'}}} Permissions
        </a>
        <a href="/settings/security" class="nav-item {{#if (eq active 'security')}}active{{/if}}">
          {{{icon 'lock' 'size-4'}}} Security
        </a>
        <a href="/plugins" class="nav-item {{#if (eq active 'plugins')}}active{{/if}}">
          {{{icon 'puzzle' 'size-4'}}} ForgeX Plugins
        </a>
      {{/if}}
      <a href="/settings" class="nav-item {{#if (eq active 'settings')}}active{{/if}}">
        {{{icon 'settings' 'size-4'}}} Settings
      </a>
    </div>
  </div>
</aside>
<div id="sidebar-backdrop" class="fixed inset-0 z-30 hidden bg-black/50 lg:hidden"></div>
